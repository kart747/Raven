# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Enables POST /api/v1/admin/* when set; send it as the X-Admin-Key header
ADMIN_API_KEY=
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000
# Enables weekly re-import of Lok Sabha activity inside the API process
ENABLE_SCHEDULED_INGEST=0
# Postgres instead of SQLite, e.g. postgresql+psycopg://user:pass@localhost:5432/raven
DATABASE_URL=
RATE_LIMIT_PER_MINUTE=0
LIVE_ENABLED=1
LIVE_RETENTION_DAYS=60
